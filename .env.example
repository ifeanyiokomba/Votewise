# ─────────────────────────────────────────────────────────────────────
# Votewise — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git — it contains secrets.

# ─── Database ───
# Neon Postgres connection string (rotate if credentials were ever exposed)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── Secrets (generate with: openssl rand -hex 32) ───
# Used to sign session JWTs (HS256). Must be ≥ 32 characters.
SESSION_SECRET=

# Dedicated encryption key for AES-256-GCM provider credential storage.
# Must be DIFFERENT from SESSION_SECRET — do not reuse.
# If a SESSION_SECRET leak happens, provider credentials stay safe.
ENCRYPTION_KEY=

# ─── App config ───
NEXT_PUBLIC_APP_URL=https://votewise.com.ng
NEXT_PUBLIC_APP_DOMAIN=votewise.com.ng

# ─── Provider config (defaults to "mock" for all) ───
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# AWS SES (EMAIL_PROVIDER=ses)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=eu-central-1
AWS_SES_FROM_EMAIL=noreply@votewise.com.ng

# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@votewise.com.ng

# Termii (SMS_PROVIDER=termii / WHATSAPP_PROVIDER=termii)
TERMII_API_KEY=
TERMII_SENDER_ID=Votewise
TERMII_CHANNEL=dnd
TERMII_WHATSAPP_SENDER=

# ─── Platform admin contact ───
# Where negotiation requests get emailed
PLATFORM_ADMIN_EMAIL=admin@votewise.com.ng
PLATFORM_PHONE=+2348000000000
VOTEWISE_WHATSAPP_NUMBER=+2348000000000

# ─── Dev-only flags ───
# Set to "true" ONLY in local dev to echo OTP codes in API responses.
# NEVER set this in production.
ENABLE_OTP_DEV_ECHO=false

# ─── Paystack (payment gateway) ───
# Get these from https://dashboard.paystack.com/settings/developer
# If not set, the payment flow falls back to mock mode (instant completion, no charge).
# In production, MUST be set to accept real payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
